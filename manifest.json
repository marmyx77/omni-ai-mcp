{
  "dxt_version": "0.1",
  "name": "omni-ai-mcp",
  "display_name": "Omni AI MCP",
  "version": "4.8.0",
  "description": "Multi-AI MCP bridge: Gemini + 400+ models via OpenRouter. 28 tools: text, code, images, video (Omni), music (Lyria), TTS and voices, transcription, video analysis, embeddings, RAG, Deep Research, Antigravity agent.",
  "author": {
    "name": "Marco Armellino",
    "url": "https://github.com/marmyx77"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/marmyx77/omni-ai-mcp"
  },
  "license": "MIT",
  "server": {
    "type": "python",
    "entry_point": "omni-ai-mcp",
    "mcp_config": {
      "command": "uvx",
      "args": ["omni-ai-mcp"],
      "env": {
        "GEMINI_API_KEY": "${user_config.gemini_api_key}",
        "OPENROUTER_API_KEY": "${user_config.openrouter_api_key}"
      }
    }
  },
  "compatibility": {
    "platforms": ["darwin", "win32", "linux"]
  },
  "user_config": {
    "gemini_api_key": {
      "type": "string",
      "title": "Google Gemini API Key",
      "description": "Required. Get yours at https://aistudio.google.com/app/apikey",
      "sensitive": true,
      "required": true
    },
    "openrouter_api_key": {
      "type": "string",
      "title": "OpenRouter API Key",
      "description": "Optional. Enables 400+ models (GPT-4o, Llama, Mistral, Claude via OR). Get yours at https://openrouter.ai/keys",
      "sensitive": true,
      "required": false
    }
  }
}
